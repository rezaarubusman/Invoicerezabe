<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Invoice {{invoice.number}}</title>
  <style>
    body {
      margin: 0;
      padding: 40px;
      font-family: Arial, Helvetica, sans-serif;
      color: #27272a;
      background-color: #ffffff;
      font-size: 14px;
    }
    .header {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      margin-bottom: 40px;
    }
    .header-right {
      text-align: right;
    }
    .title {
      font-size: 32px;
      font-weight: bold;
      color: #18181b;
      margin: 0 0 8px 0;
      letter-spacing: 2px;
    }
    .info-section {
      display: flex;
      justify-content: space-between;
      margin-bottom: 40px;
    }
    .info-block h3 {
      font-size: 12px;
      color: #71717a;
      text-transform: uppercase;
      margin: 0 0 8px 0;
      letter-spacing: 0.5px;
    }
    .info-block p {
      margin: 0 0 4px 0;
      line-height: 1.5;
    }
    table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 32px;
    }
    th {
      background-color: #f4f4f5;
      color: #52525b;
      font-size: 12px;
      text-transform: uppercase;
      padding: 12px;
      text-align: left;
      border-bottom: 2px solid #e4e4e7;
    }
    th.right, td.right {
      text-align: right;
    }
    td {
      padding: 16px 12px;
      border-bottom: 1px solid #e4e4e7;
    }
    .summary-box {
      width: 300px;
      margin-left: auto;
    }
    .summary-row {
      display: flex;
      justify-content: space-between;
      padding: 8px 0;
      color: #52525b;
    }
    .summary-row.total {
      font-weight: bold;
      color: #18181b;
      font-size: 18px;
      border-top: 2px solid #e4e4e7;
      padding-top: 12px;
      margin-top: 4px;
    }
    .footer {
      margin-top: 48px;
      padding-top: 24px;
      border-top: 1px solid #e4e4e7;
      font-size: 12px;
      color: #71717a;
      line-height: 1.6;
    }
  </style>
</head>
<body>

  <div class="header">
    <div>
      <!-- Anda bisa mengganti ini dengan Logo Perusahaan (Base64) jika ada -->
      <h2 style="margin: 0; color: #18181b;">Fakturia</h2>
      <p style="margin: 4px 0; color: #71717a;">support@fakturia.com</p>
    </div>
    <div class="header-right">
      <h1 class="title">INVOICE</h1>
      <p style="margin: 0; color: #71717a;">#{{invoice.number}}</p>
    </div>
  </div>

  <div class="info-section">
    <div class="info-block">
      <h3>Bill To</h3>
      <p><strong>{{invoice.client.name}}</strong></p>
      {{#if invoice.client.company}}
        <p>{{invoice.client.company}}</p>
      {{/if}}
      <p>{{invoice.client.address}}</p>
      <p>{{invoice.client.email}}</p>
    </div>
    <div class="info-block header-right">
      <h3>Invoice Details</h3>
      <p><strong>Issue Date:</strong> {{invoice.formattedIssueDate}}</p>
      <p><strong>Due Date:</strong> {{invoice.formattedDueDate}}</p>
      <p><strong>Status:</strong> {{invoice.status}}</p>
    </div>
  </div>

  <table>
    <thead>
      <tr>
        <th>Item Description</th>
        <th class="right">Qty</th>
        <th class="right">Price</th>
        <th class="right">Amount</th>
      </tr>
    </thead>
    <tbody>
      {{#each invoice.items}}
      <tr>
        <td>
          <p style="margin: 0; font-weight: bold; color: #18181b;">{{name}}</p>
          {{#if description}}
            <p style="margin: 4px 0 0 0; font-size: 12px; color: #71717a;">{{description}}</p>
          {{/if}}
        </td>
        <td class="right">{{quantity}}</td>
        <td class="right">{{formattedUnitPrice}}</td>
        <td class="right">{{formattedAmount}}</td>
      </tr>
      {{/each}}
    </tbody>
  </table>

  <div class="summary-box">
    <div class="summary-row">
      <span>Subtotal</span>
      <span>{{invoice.formattedSubtotal}}</span>
    </div>
    <div class="summary-row">
      <span>Tax</span>
      <span>{{invoice.formattedTax}}</span>
    </div>
    <div class="summary-row">
      <span>Discount</span>
      <span>- {{invoice.formattedDiscount}}</span>
    </div>
    <div class="summary-row total">
      <span>Total Due ({{invoice.currency}})</span>
      <span>{{invoice.formattedTotal}}</span>
    </div>
  </div>

  <div class="footer">
    {{#if invoice.notes}}
      <p><strong>Notes:</strong><br>{{invoice.notes}}</p>
    {{/if}}
    {{#if invoice.terms}}
      <p style="margin-top: 12px;"><strong>Terms & Conditions:</strong><br>{{invoice.terms}}</p>
    {{/if}}
  </div>

</body>
</html>