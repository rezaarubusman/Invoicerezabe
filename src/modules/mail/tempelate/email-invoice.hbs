<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />
  <title>Your Invoice</title>
</head>

<body
  style="
    margin: 0;
    padding: 0;
    background-color: #f4f4f5;
    font-family: Arial, Helvetica, sans-serif;
  "
>
  <table
    width="100%"
    cellpadding="0"
    cellspacing="0"
    style="padding: 40px 20px;"
  >
    <tr>
      <td align="center">

        <table
          width="100%"
          cellpadding="0"
          cellspacing="0"
          style="
            max-width: 600px;
            background: #ffffff;
            border-radius: 12px;
            padding: 40px;
          "
        >

          <tr>
            <td>

              <!-- 
                Menggunakan white-space: pre-wrap agar 
                \n dari textarea Frontend menjadi baris baru (enter) 
              -->
              <div 
                style="
                  font-size: 16px; 
                  color: #27272a; 
                  line-height: 1.6; 
                  white-space: pre-wrap;
                "
              >{{message}}</div>

              <p 
                style="
                  font-size: 14px; 
                  color: #52525b; 
                  margin-top: 40px; 
                  padding-top: 24px; 
                  border-top: 1px solid #e4e4e7;
                "
              >
                <strong>Note:</strong> Please find your detailed invoice attached to this email as a PDF document.
              </p>

              <hr 
                style="
                  border: none; 
                  border-top: 1px solid #e4e4e7; 
                  margin: 32px 0 24px 0;
                " 
              />

              <p style="font-size: 12px; color: #71717a; margin: 0;">
                Fakturia
              </p>

            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>
</body>
</html>