<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>Password reset successful</title>
</head>

<body
  style="
    margin: 0;
    padding: 40px 20px;
    background-color: #f4f4f5;
    font-family: Arial, Helvetica, sans-serif;
    color: #18181b;
  "
>
  <table
    width="100%"
    cellpadding="0"
    cellspacing="0"
    style="width: 100%;"
  >
    <tr>
      <td align="center">

        <table
          width="600"
          cellpadding="0"
          cellspacing="0"
          style="
            width: 100%;
            max-width: 600px;
            background-color: #ffffff;
            border-radius: 12px;
            padding: 40px;
          "
        >
          <tr>
            <td>

              <h1
                style="
                  margin: 0 0 24px;
                  font-size: 28px;
                "
              >
                Password reset successful
              </h1>

              <p
                style="
                  margin: 0 0 16px;
                  font-size: 16px;
                  line-height: 1.6;
                "
              >
                Hi {{name}},
              </p>

              <p
                style="
                  margin: 0 0 16px;
                  font-size: 16px;
                  line-height: 1.6;
                "
              >
                Your Fakturia account password has been successfully changed.
              </p>

              <p
                style="
                  margin: 0 0 28px;
                  font-size: 16px;
                  line-height: 1.6;
                "
              >
                You can now log in using your new password.
              </p>

              <p style="margin: 0 0 32px;">
                <a
                  href="{{loginUrl}}"
                  style="
                    display: inline-block;
                    padding: 13px 24px;
                    background-color: #18181b;
                    color: #ffffff;
                    text-decoration: none;
                    border-radius: 8px;
                    font-size: 15px;
                    font-weight: 600;
                  "
                >
                  Log In
                </a>
              </p>

              <p
                style="
                  margin: 0 0 24px;
                  font-size: 14px;
                  line-height: 1.6;
                  color: #52525b;
                "
              >
                If you did not make this change, please contact support immediately and secure your account.
              </p>

              <hr
                style="
                  border: 0;
                  border-top: 1px solid #e4e4e7;
                  margin: 32px 0;
                "
              />

              <p
                style="
                  margin: 0;
                  font-size: 12px;
                  color: #71717a;
                "
              >
                Fakturia
              </p>

            </td>
          </tr>
        </table>

      </td>
    </tr>
  </table>
</body>
</html>